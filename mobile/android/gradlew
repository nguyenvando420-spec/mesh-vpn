#!/bin/sh
# POSIX Gradle wrapper launcher for Mesh VPN Android.
# Executes gradle/wrapper/gradle-wrapper.jar when bootstrapped, or falls back to system gradle.

set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -f "$WRAPPER_JAR" ]; then
  if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
  else
    JAVACMD="java"
  fi
  exec "$JAVACMD" -Xmx64m -Xms64m -jar "$WRAPPER_JAR" "$@"
elif command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
else
  echo "ERROR: gradle/wrapper/gradle-wrapper.jar is absent and 'gradle' is not on PATH." >&2
  echo "Run 'gradle wrapper --gradle-version 8.11.1' in mobile/android or install Gradle 8.11.1." >&2
  exit 1
fi
