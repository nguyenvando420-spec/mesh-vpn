# EditorConfig — https://editorconfig.org
# Chuẩn định dạng thống nhất cho toàn dự án mesh-vpn (Rust 1.94.1 — xem docs/03-system-design/coding-standards.md §1).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust: chuẩn rustfmt dùng 4 dấu cách (spaces), độ rộng dòng tối đa 100 cột.
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# Mobile Kotlin / Gradle Kotlin DSL / Swift: 4 dấu cách (spaces), LF, UTF-8.
[*.{kt,kts,swift}]
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 120

[desktop/macos/**/*.swift]
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json,plist,entitlements,strings,xcstrings,service,xml,pbxproj}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
# Markdown dùng 2 dấu cách cuối dòng để ngắt dòng cứng → không tự cắt khoảng trắng.
trim_trailing_whitespace = false
max_line_length = off

# Script Windows giữ CRLF (khớp .gitattributes).
[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
