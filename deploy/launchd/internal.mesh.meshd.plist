<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>internal.mesh.meshd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/mesh/meshd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>5</integer>
  <key>WorkingDirectory</key>
  <string>/var/db/mesh</string>
  <key>StandardOutPath</key>
  <string>/var/log/mesh/meshd.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/mesh/meshd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MESH_STATE_DIR</key>
    <string>/var/db/mesh</string>
  </dict>
</dict>
</plist>
