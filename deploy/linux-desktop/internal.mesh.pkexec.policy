<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Mesh VPN</vendor>
  <vendor_url>https://mesh.internal/docs/deployment</vendor_url>
  <action id="internal.mesh.pkexec.meshvpn">
    <description>Manage Mesh VPN system service and tunnel configuration</description>
    <message>Authentication is required to manage the Mesh VPN agent daemon and network routes.</message>
    <icon_name>mesh-vpn</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/MeshVPN</annotate>
  </action>
</policyconfig>
